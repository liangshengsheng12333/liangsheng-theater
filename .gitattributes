# Auto detect text files and perform LF normalization
* text=auto

# Source and documentation
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
